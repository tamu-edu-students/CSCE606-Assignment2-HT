<%= form_with(model: movie, html: { class: "form" }) do |form| %>
  <% if movie.errors.any? %>
    <div class="form-errors">
      <h2><%= pluralize(movie.errors.count, "error") %> prohibited this movie from being saved:</h2>
      <ul>
        <% movie.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= hidden_field_tag :sort, sort if sort.present? %>
  <%= hidden_field_tag :direction, direction if direction.present? %>

  <div class="form-row">
    <div class="form-field">
      <%= form.label :title %>
      <%= form.text_field :title %>
    </div>

    <div class="form-field">
      <%= form.label :rating %>
      <%= form.text_field :rating %>
    </div>

    <div class="form-field">
      <%= form.label :release_date %>
      <%= form.datetime_field :release_date %>
    </div>
  </div>

  <div class="form-row">
    <div class="form-field">
      <%= form.label :director %>
      <%= form.text_field :director %>
    </div>

    <div class="form-field">
      <%= form.label :duration %>
      <%= form.number_field :duration %>
    </div>

    <div class="form-field">
      <%= form.label :genre %>
      <%= form.text_field :genre %>
    </div>
  </div>

  <div class="form-row">
    <div class="form-field">
      <%= form.label :description %>
      <%= form.text_area :description %>
    </div>

    <div class="form-field">
      <%= form.label :cast %>
      <%= form.text_area :cast %>
    </div>
  </div>

  <div class="actions" style="justify-content: end">
    <%= link_to "Cancel", (request.referer || movies_path(request.query_parameters)), class: "btn btn-danger" %>
    <%= form.submit "Submit", class: "btn btn-submit" %>
  </div>
<% end %>
