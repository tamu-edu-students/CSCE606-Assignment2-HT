<% content_for :title, "Edit movie" %>

<h1>
  <%= link_to "🍿 Rotten Potatoes", movies_path(request.query_parameters), class: "title" %>
</h1>

<p class="notice"><%= notice %></p>

<div class="page-header">
  <h2>Edit <%= @movie.title %></h2>
  <div class="">
    <%= link_to 'Back to Movies', movies_path(request.query_parameters), class: "btn btn-secondary" %>
    <%= link_to "Show this movie", movie_path(@movie, request.query_parameters), class: "btn btn-primary" %>
  </div>
</div>

<%= render "form", movie: @movie, sort: params[:sort], direction: params[:direction]%>
